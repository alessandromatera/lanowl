# lanowl's deployment settings — copy to docker/.env
LANOWL_HOST_IP=192.168.88.5               # this host's address on the LAN (the sandbox walls it off)
LANOWL_MODEL_URL=http://192.168.88.6:11434    # where the model runs (leave as is without a model)
LANOWL_WEB_PORT=80                        # the dashboard
TZ=Europe/Berlin                          # your time zone: sunrise, sunset and the router's log
# LANOWL_TG_TOKEN=                        # secrets: config/secrets.yaml, or here (see its end)
