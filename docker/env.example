# lanowl's deployment settings — optional. Copy to docker/.env only to set one of these; each
# wins over config.yaml, and Settings on the dashboard then shows it locked.
# LANOWL_HOST_IP=192.168.88.5             # this host's address on the LAN (lanowl finds it by itself;
#                                         # the model's sandboxed shells need it to wall it off)
# LANOWL_MODEL_URL=http://192.168.88.6:11434   # where the model runs (or model.url in Settings)
# LANOWL_WEB_PORT=80                      # the dashboard (default 8088, or web.port in Settings)
# TZ=Europe/Berlin                        # your time zone (or timezone in Settings)
# LANOWL_TG_TOKEN=                        # secrets: secrets.yaml (Settings → Secrets), or here
