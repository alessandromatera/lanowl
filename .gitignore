# --- secrets and your own config: never commit ------------------------------
/config/*
!/config/.gitignore
secrets.yaml
*.secrets.yaml
.env
docker/.env
*.key
id_*
telegram_token
mikrotik

# --- the maintainer's own notes, plan, to-do and tests -------------------------
.claude/
TODO.md
/tests/

# --- local state -------------------------------------------------------------
*.sqlite
*.sqlite-*
*.log
tg_outbox.json
known_hosts_devices

# --- generated ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.test-logs/
dist/
build/
*.egg-info/
.DS_Store
